# Only needed when the API is on a different host than the frontend.
# VITE_API_BASE=https://your-api.example.com
# Where `npm run dev` forwards /api (default http://127.0.0.1:5000):
# VITE_API_PROXY=http://127.0.0.1:5000

# Optional. CARTO's map styles (Voyager, closest to the mockup, and Dark Matter) need a key since 25 Sep 2026,
# free for non-commercial use: https://carto.com/basemaps/apikey. Without it the map uses Esri's tiles,
# which need no key (a colourful street map in light mode, dark gray in dark mode).
# VITE_CARTO_KEY=
