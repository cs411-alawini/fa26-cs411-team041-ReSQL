# Copy to backend/.env and fill in. Never commit backend/.env.

# Database. For Cloud SQL, run the Cloud SQL Auth Proxy and use 127.0.0.1:3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# On Cloud Run, use the Unix socket instead of host/port:
# DB_UNIX_SOCKET=/cloudsql/<project>:<region>:<instance>

# Long random string used to sign login tokens.
JWT_SECRET=change-me

# osrm | offline, nominatim | offline, open-meteo | offline
ROUTING_PROVIDER=osrm
GEOCODER=nominatim
WEATHER_PROVIDER=open-meteo

# stage2_view (placeholder, reads CellRiskCurrent) | ml (not implemented yet)
RISK_MODEL=stage2_view

CORS_ORIGINS=http://localhost:5173
# FRONTEND_DIST=../frontend/dist
